<?xml version="1.0"?>
<robot name="robot_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================================================================
       6-DOF SERIAL ROBOTIC ARM

       All dimensions are ASSUMPTIONS for a small desktop-class arm.
       Change any number here and the whole model updates.

       Units: metres, kilograms, radians.
       Convention (REP 103): X forward, Y left, Z up.

       Every link extends along its own +Z axis, so each joint origin
       sits at the parent link's length. This keeps the chain readable.
       ================================================================== -->

  <!-- ============== DIMENSIONS (edit these to resize the arm) ========= -->
  <xacro:property name="base_radius" value="0.10"/>
  <xacro:property name="base_length" value="0.06"/>
  <xacro:property name="base_mass"   value="2.0"/>

  <xacro:property name="l1_radius" value="0.060"/>
  <xacro:property name="l1_length" value="0.18"/>
  <xacro:property name="l1_mass"   value="1.2"/>

  <xacro:property name="l2_radius" value="0.050"/>
  <xacro:property name="l2_length" value="0.30"/>
  <xacro:property name="l2_mass"   value="1.0"/>

  <xacro:property name="l3_radius" value="0.045"/>
  <xacro:property name="l3_length" value="0.25"/>
  <xacro:property name="l3_mass"   value="0.8"/>

  <xacro:property name="l4_radius" value="0.035"/>
  <xacro:property name="l4_length" value="0.12"/>
  <xacro:property name="l4_mass"   value="0.4"/>

  <xacro:property name="l5_radius" value="0.032"/>
  <xacro:property name="l5_length" value="0.10"/>
  <xacro:property name="l5_mass"   value="0.3"/>

  <xacro:property name="l6_radius" value="0.030"/>
  <xacro:property name="l6_length" value="0.07"/>
  <xacro:property name="l6_mass"   value="0.2"/>

  <!-- ============== MATERIALS (colours for RViz) ====================== -->
  <material name="dark_grey">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.90 0.45 0.05 1.0"/>
  </material>
  <material name="light_grey">
    <color rgba="0.70 0.70 0.70 1.0"/>
  </material>

  <!-- ============== INERTIA MACRO ====================================
       Inertia tells the physics engine how hard a body is to rotate.
       Gazebo NEEDS this. A link with zero or missing inertia either
       gets ignored or makes the solver explode (the robot flies apart
       or vibrates violently). These are the standard formulas for a
       solid cylinder rotating about its centre of mass.
       ================================================================== -->
  <xacro:macro name="cylinder_inertia" params="mass radius length">
    <inertial>
      <!-- Centre of mass sits at the middle of the cylinder -->
      <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass*(3*radius*radius + length*length)/12}" ixy="0.0" ixz="0.0"
        iyy="${mass*(3*radius*radius + length*length)/12}" iyz="0.0"
        izz="${mass*radius*radius/2}"/>
    </inertial>
  </xacro:macro>

  <!-- ============== LINK MACRO =======================================
       Every arm link is the same shape, so we describe it once.
       visual    = what you see
       collision = what physics uses for contact (kept identical here
                   for simplicity; real robots use simpler collision)
       inertial  = how it responds to forces
       ================================================================== -->
  <xacro:macro name="arm_link" params="name radius length mass material">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${material}"/>
      </visual>

      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>

      <xacro:cylinder_inertia mass="${mass}" radius="${radius}" length="${length}"/>
    </link>
  </xacro:macro>

  <!-- ============== WORLD AND BASE ==================================== -->

  <!-- An empty root frame. Fixing base_link to it stops the arm from
       falling over or sliding around in the simulator. -->
  <link name="world"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_length}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_length}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia mass="${base_mass}"
                            radius="${base_radius}"
                            length="${base_length}"/>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============== JOINT 1 — BASE YAW ===============================
       Rotates the whole arm around the vertical axis.
       ================================================================== -->
  <xacro:arm_link name="link_1" radius="${l1_radius}"
                  length="${l1_length}" mass="${l1_mass}" material="orange"/>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child  link="link_1"/>
    <origin xyz="0 0 ${base_length}" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="60.0" velocity="2.0"/>
  </joint>

  <!-- ============== JOINT 2 — SHOULDER PITCH ========================== -->
  <xacro:arm_link name="link_2" radius="${l2_radius}"
                  length="${l2_length}" mass="${l2_mass}" material="light_grey"/>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child  link="link_2"/>
    <origin xyz="0 0 ${l1_length}" rpy="0 0 0"/>
    <axis   xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="60.0" velocity="2.0"/>
  </joint>

  <!-- ============== JOINT 3 — ELBOW PITCH ============================= -->
  <xacro:arm_link name="link_3" radius="${l3_radius}"
                  length="${l3_length}" mass="${l3_mass}" material="orange"/>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child  link="link_3"/>
    <origin xyz="0 0 ${l2_length}" rpy="0 0 0"/>
    <axis   xyz="0 1 0"/>
    <limit lower="-2.6180" upper="2.6180" effort="40.0" velocity="2.5"/>
  </joint>

  <!-- ============== JOINT 4 — WRIST ROLL ============================== -->
  <xacro:arm_link name="link_4" radius="${l4_radius}"
                  length="${l4_length}" mass="${l4_mass}" material="light_grey"/>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child  link="link_4"/>
    <origin xyz="0 0 ${l3_length}" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="20.0" velocity="3.0"/>
  </joint>

  <!-- ============== JOINT 5 — WRIST PITCH ============================= -->
  <xacro:arm_link name="link_5" radius="${l5_radius}"
                  length="${l5_length}" mass="${l5_mass}" material="orange"/>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child  link="link_5"/>
    <origin xyz="0 0 ${l4_length}" rpy="0 0 0"/>
    <axis   xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="15.0" velocity="3.0"/>
  </joint>

  <!-- ============== JOINT 6 — TOOL ROLL =============================== -->
  <xacro:arm_link name="link_6" radius="${l6_radius}"
                  length="${l6_length}" mass="${l6_mass}" material="light_grey"/>

  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child  link="link_6"/>
    <origin xyz="0 0 ${l5_length}" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="3.0"/>
  </joint>

  <!-- ============== END EFFECTOR =====================================
       A massless frame at the tool tip. Forward kinematics in Phase 10
       will compute the pose of THIS frame relative to base_link.
       ================================================================== -->
  <link name="end_effector"/>

  <joint name="link_6_to_end_effector" type="fixed">
    <parent link="link_6"/>
    <child  link="end_effector"/>
    <origin xyz="0 0 ${l6_length}" rpy="0 0 0"/>
  </joint>

</robot>
